# Supabase — https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Giriş zorunluluğu (fail-closed). Varsayılan: true — değişken hiç tanımlanmasa da giriş zorunludur.
# Yalnızca yerel demo/kurulum için açıkça "false" verin; Vercel (Production/Preview) ortamında
# ASLA false yapmayın.
NEXT_PUBLIC_REQUIRE_AUTH=true

# Sadece sunucu tarafı işlemler için (opsiyonel, seed/admin script'leri):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Ads — yalnızca sunucu tarafında tutulur
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Meta Ads — yalnızca sunucu tarafında tutulur
META_ADS_ACCESS_TOKEN=
META_ADS_API_VERSION=v25.0
