# Supabase — https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Giriş zorunluluğu (fail-closed). Varsayılan: true — değişken hiç tanımlanmasa da giriş zorunludur.
# Yalnızca yerel demo/kurulum için açıkça "false" verin; Vercel (Production/Preview) ortamında
# ASLA false yapmayın.
NEXT_PUBLIC_REQUIRE_AUTH=true

# Sadece sunucu tarafı işlemler için (opsiyonel, seed/admin script'leri):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reklam bağlantısı (Google Ads + Meta Ads): kurulum rehberi docs/ads-baglanti.md, doğrulama: npm run ads:check
# Google Ads — yalnızca sunucu tarafında tutulur
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Meta Ads — yalnızca sunucu tarafında tutulur
META_ADS_ACCESS_TOKEN=
META_ADS_API_VERSION=v25.0
# Yalnızca yerelde (ads:check token ayrıntısı için, isteğe bağlı; Vercel'e GİRMEYİN):
# META_APP_ID=
# META_APP_SECRET=

# Lead girişi (POST /api/leads) — yalnızca sunucu tarafı; kurulum: supabase/migrations/README-0017.md
# LEAD_WEBHOOK_SECRET: >=16 karakter rastgele sır (Web3Forms webhook'u x-rast-lead-secret başlığıyla gönderir)
# LEAD_INTAKE_ORG_ID: lead'lerin yazılacağı organizations.id (uuid)
LEAD_WEBHOOK_SECRET=
LEAD_INTAKE_ORG_ID=

# Müşteri Bulma (0019) — yalnızca sunucu tarafı; ayrıntı: docs/musteri-bulma.md, supabase/migrations/README-0019.md
# GOOGLE_PLACES_API_KEY: Places API (New). Boşsa keşif örnek (sahte) veriyle çalışır.
GOOGLE_PLACES_API_KEY=
# CRON_SECRET: >=16 karakter; Vercel Cron "Authorization: Bearer" ile gönderir. SHA-256'sı outreach_settings'e yazılır.
CRON_SECRET=
# E-posta gönderimi VARSAYILAN KAPALI (İYS kaydı bekleniyor). Yalnızca İYS kaydından sonra "true".
OUTREACH_EMAIL_ENABLED=
DAILY_SEND_CAP=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# İsteğe bağlı: ret bağlantısının alan adı (yoksa Vercel üretim alan adı)
APP_BASE_URL=

# Yeni lead iç bildirimi (docs/lead-bildirim.md) — yalnızca sunucu tarafı.
# LEAD_NOTIFY_TO: virgülle ayrılmış alıcı adresleri (ör. a@rastcreative.com,b@rastcreative.com; en fazla 10).
# Yeni lead / tekrar başvuru kaydedilince ekibe kısa e-posta gider. Yukarıdaki SMTP_* de tanımlı olmalı;
# ikisinden biri yoksa bildirim sessizce atlanır. Ekibin kendi kutusuna giden iç bildirimdir:
# OUTREACH_EMAIL_ENABLED (Müşteri Bulma) bayrağından BAĞIMSIZDIR. Gönderim hatası lead kaydını etkilemez.
LEAD_NOTIFY_TO=
